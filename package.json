{
  "name": "sleeper-mcp",
  "version": "1.0.0",
  "description": "Typescript MCP Server implementation for Sleeper Fantasy Football API",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swcollard/sleeper-mcp.git"
  },
  "keywords": [],
  "author": "swcollard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/swcollard/sleeper-mcp/issues"
  },
  "homepage": "https://github.com/swcollard/sleeper-mcp#readme",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
